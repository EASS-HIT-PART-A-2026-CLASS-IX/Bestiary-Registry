# Google Gemini API key — required for async lore generation
GEMINI_API_KEY=

# JWT signing secret — required for auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local SQLite path — used when running without Docker (DB_PATH takes priority over DATABASE_URL locally)
DB_PATH=./creatures.db

# Postgres connection string — only needed for Render/PostgreSQL deployment.
# Locally the project uses SQLite via DB_PATH above; this variable is ignored in local dev.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/creatures

# Redis connection string — default for local Docker
REDIS_URL=redis://redis:6379/0

# Postgres credentials (used by the postgres Docker service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=creatures
